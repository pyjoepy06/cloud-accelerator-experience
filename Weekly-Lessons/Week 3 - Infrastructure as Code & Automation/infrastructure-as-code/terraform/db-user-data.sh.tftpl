#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y mysql-server
systemctl enable --now mysql
cat >/etc/mysql/mysql.conf.d/99-harborpoint.cnf <<'MYSQLCONF'
[mysqld]
bind-address = 0.0.0.0
MYSQLCONF
systemctl restart mysql
mysql <<'SQL'
CREATE DATABASE IF NOT EXISTS cloudcapstone;
CREATE USER IF NOT EXISTS 'cloudapp'@'%' IDENTIFIED BY '${db_password}';
GRANT SELECT, INSERT ON cloudcapstone.* TO 'cloudapp'@'%';
USE cloudcapstone;
CREATE TABLE IF NOT EXISTS customers (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  email VARCHAR(150) NOT NULL
);
INSERT INTO customers (name, email) VALUES
('John Smith', 'john@example.com'),
('Sarah Johnson', 'sarah@example.com'),
('Michael Brown', 'michael@example.com');
SQL
